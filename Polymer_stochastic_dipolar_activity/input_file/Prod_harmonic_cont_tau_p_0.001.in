units              lj

atom_style         angle

dimension          3

boundary           s s s

read_restart       p1000_random_persistent_gamma_0.1_1.restart.10000000

neighbor           2.0 bin

neigh_modify       every 1 delay 0 one 100000 page 1000000 check yes

pair_style         lj/cut 1.12

pair_coeff         * * 1.0 1.0 1.12

pair_modify        shift yes

bond_style         harmonic/SDF

#bond_coeff <type> <k> <r0>  <spp0> <tau_act> <activity_flag> <seed> <tau_p>
bond_coeff         * 30 1.5  100.0 5.0 1 532168 0.001 

angle_style        cosine

angle_coeff        1 5.0

################################################################

minimize           1e-6 1e-7 100000 100000

fix                ensemble_2 all bd 1.00 0.1 834120

timestep           0.0001

compute            Rg_full_polymer all gyration

fix                Rg_full_polymer_avg all ave/time 100 1 100 c_Rg_full_polymer file Rg_cont_bd_harmonic_F100_sim9.dat

thermo             100

#dump               1 all custom 100 p1000_cont_bd_harmonic_F100_sim9.xyz id type x y z ix iy iz

#dump_modify        1 sort id

dump               2 all custom 1000 traj_p1000_cont_bd_harmonic_F100_sim1.lammpstrj id type xu yu zu ix iy iz

run                20000000
